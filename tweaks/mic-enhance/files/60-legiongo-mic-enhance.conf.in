# Legion Go internal mic enhancement (legiongo-steamos mic-enhance). Remove with: ./legiongo.sh uninstall mic-enhance
# Chain: high-pass 85 Hz -> warmth shelf +3 dB @180 Hz -> mud cut -2.5 dB @400 Hz -> presence +2 dB @3.5 kHz
#        -> caps Compress (RMS, saturating) -> safety clamp at -0.2 dBFS
context.modules = [
{ name = libpipewire-module-filter-chain
  flags = [ nofail ]
  args = {
    node.description = "Enhanced Microphone"
    media.name       = "Enhanced Microphone"
    filter.graph = {
      nodes = [
        { type = builtin name = hp    label = bq_highpass  control = { "Freq" = 85.0   "Q" = 0.707 } }
        { type = builtin name = warm  label = bq_lowshelf  control = { "Freq" = 180.0  "Q" = 0.7  "Gain" = 3.0 } }
        { type = builtin name = mud   label = bq_peaking   control = { "Freq" = 400.0  "Q" = 1.0  "Gain" = -2.5 } }
        { type = builtin name = pres  label = bq_peaking   control = { "Freq" = 3500.0 "Q" = 0.8  "Gain" = 2.0 } }
        { type = ladspa  name = comp  plugin = /usr/lib/ladspa/caps.so label = Compress
          control = { "measure" = 1 "mode" = 2 "threshold" = 0.3 "strength" = 0.6 "attack" = 0.05 "release" = 0.4 "gain (dB)" = 4.0 } }
        { type = builtin name = clip  label = clamp control = { "Min" = -0.977 "Max" = 0.977 } }
      ]
      links = [
        { output = "hp:Out"   input = "warm:In" }
        { output = "warm:Out" input = "mud:In" }
        { output = "mud:Out"  input = "pres:In" }
        { output = "pres:Out" input = "comp:in" }
        { output = "comp:out" input = "clip:In" }
      ]
    }
    capture.props = {
      node.name      = "capture.legiongo_mic_enhance"
      audio.position = [ MONO ]
      target.object  = "@MIC_NODE@"
      node.passive   = true
      node.dont-reconnect = false
    }
    playback.props = {
      node.name      = "legiongo_mic_enhanced"
      node.description = "Enhanced Microphone"
      media.class    = Audio/Source
      audio.position = [ MONO ]
    }
  }
}
]
