#!/bin/sh
# Emergency: return to the stock SteamOS InputPlumber immediately (works over SSH or on a TTY).
# Removes only the systemd drop-in of the precision-touchpad tweak; reinstall the tweak to undo.
set -e
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
rm -f @DROPIN@
systemctl daemon-reload
systemctl restart inputplumber.service
echo "Stock InputPlumber restored. Clean up later with: legiongo.sh uninstall precision-touchpad"
