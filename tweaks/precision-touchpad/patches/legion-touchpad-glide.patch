+    /// Advance the lift-off filter: update the release delay and forward frames that are due.
+    fn filter_tick(&mut self, events: &mut Vec<Event>, fast: bool) {
+        let now = Instant::now();
+        let dt = now.duration_since(self.last_tick).as_secs_f64() * 1000.0;
+        self.last_tick = now;
+        let hold = LIFT_FILTER_DELAY.as_secs_f64() * 1000.0;
+        if self.first_touch.elapsed() >= LIFT_FILTER_TAP_WINDOW {
+            if !self.live && (fast || self.move_start.elapsed() >= LIFT_FILTER_DELAY) {
+                self.live = true;                    // the movement persisted: it is deliberate
+            }
+            if self.live && self.last_motion.elapsed() >= LIFT_FILTER_STILL {
+                self.live = false;                   // finger still again: re-arm (nothing is moving)
+                self.move_start = now;
+                self.delay_ms = hold;
+            }
+        }
+        let target = if self.live || fast { 0.0 } else { hold };
+        if target < self.delay_ms {
+            self.delay_ms = (self.delay_ms - LIFT_FILTER_GLIDE * dt).max(target);   // glide, no burst
+        } else {
+            self.delay_ms = target;
+        }
