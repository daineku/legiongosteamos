+    /// Forward the current touch position through the lift-off filter.
+    fn forward_touch(&mut self, events: &mut Vec<Event>, state: TouchpadDataReport) {
+        let pos = [state.touch_x_0, state.touch_y_0];
+        let dx = pos[0] as i64 - self.last_raw[0] as i64;
+        let dy = pos[1] as i64 - self.last_raw[1] as i64;
+        self.last_raw = pos;
+        let step_sq = dx * dx + dy * dy;
+        // Drags and tap-and-drag continuations, and the touch-down frame, go out live.
+        if self.is_clicked
+            || self.is_continuation
+            || (pos == self.first_touch_pos && self.pending.is_empty())
+        {
+            self.pending.clear();
+            self.sent_pos = pos;
+            self.emit(events, self.touch_event(state));
+            return;
+        }
+        let now = Instant::now();
+        let in_tap_window = self.first_touch.elapsed() < LIFT_FILTER_TAP_WINDOW;
+        if step_sq >= 1 {
+            // movement restarting after stillness (outside the tap window): hold again
+            if !in_tap_window && self.last_motion.elapsed() >= LIFT_FILTER_STILL {
+                self.move_start = now;
+                self.live = false;
+                self.delay_ms = LIFT_FILTER_DELAY.as_secs_f64() * 1000.0;
+            }
+            self.last_motion = now;
+        }
+        self.pending.push_back((now, pos[0], pos[1]));
+        self.filter_tick(events, step_sq >= LIFT_FILTER_BYPASS_SQ);
+    }
