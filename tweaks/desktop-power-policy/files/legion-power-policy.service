[Unit]
Description=Legion Go Desktop Mode power policy (event-driven; hands off in Gaming Mode)
Documentation=https://github.com/daineku/legiongosteamos/tree/main/tweaks/desktop-power-policy
After=systemd-logind.service upower.service
Wants=upower.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /etc/legion-power/legion-power-policy.py
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
